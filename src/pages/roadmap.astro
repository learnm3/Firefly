---
import { Icon } from "astro-icon/components";
import RoadmapTracker from "@/components/pages/career/RoadmapTracker.svelte";
import { careerConfig } from "@/config/careerConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="求职路线图" description="目标：库洛游戏客户端开发实习">
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="relative w-full mb-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
                        <Icon is:inline name="material-symbols:route" class="text-[1.5rem]"></Icon>
                    </div>
                    <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
                        求职路线图
                    </div>
                </div>
                <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    从 <b>C++ 补强</b> 到 <b>UE5 Demo 落地</b>，再到 <b>投递冲刺</b>——这是围绕「入职库洛游戏客户端实习」定制的完整执行计划。
                    勾选已完成的任务，进度自动保存在浏览器中。
                </p>
            </div>

            <RoadmapTracker client:load config={careerConfig} />
        </div>
    </div>
</MainGridLayout>
