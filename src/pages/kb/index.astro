---
import { Icon } from "astro-icon/components";
import KbMindMap from "@/components/pages/kb/KbMindMap.svelte";
import { kbBranchMetaList } from "@/config/kbConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { buildKbPayload } from "@/utils/kb-utils";

const payload = await buildKbPayload();
---

<MainGridLayout
  title="个人知识库 · 游戏开发学习沉淀"
  description="以思维导图记录学习笔记、踩坑手册、项目实践与成长历程（含引擎探索阶段的 C#/Unity 内容），供未来遇到同类问题时检索参考。"
>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="relative w-full mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon is:inline name="material-symbols:account-tree" class="text-[1.5rem]"></Icon>
          </div>
          <div class="text-3xl font-bold text-90">
            个人知识库
          </div>
        </div>
        <p class="text-base text-50 leading-relaxed max-w-3xl">
          这里是记录 <b class="text-90">游戏开发学习沉淀</b> 的内容体系（含引擎探索阶段的 C#/Unity 笔记）：每一条都是一份可检索的
          <span class="text-(--primary) font-medium">知识卡片</span>，独立于博客文章、又与文章互链。
          思维导图支持 <b class="text-90">按领域 / 按类型</b> 双视图切换，节点可展开收起、缩放拖拽，
          点击条目即打开完整内容——未来遇到同样的问题，来这里查。
        </p>
      </div>

      <!-- 统计卡 -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-5">
        <div class="rounded-xl bg-(--btn-plain-bg) px-4 py-3 text-center">
          <div class="text-2xl font-bold text-90">{payload.stats.total}</div>
          <div class="text-xs text-50 mt-0.5">全部条目</div>
        </div>
        {kbBranchMetaList.map((b) => (
          <div class="rounded-xl px-4 py-3 text-center" style={`background:${b.color}1f`}>
            <div class="text-2xl font-bold text-90">{payload.stats.byBranch[b.id] ?? 0}</div>
            <div class="text-xs text-50 mt-0.5">{b.name}</div>
          </div>
        ))}
      </div>

      <!-- 思维导图 -->
      <KbMindMap client:load payload={payload} />
    </div>
  </div>
</MainGridLayout>
