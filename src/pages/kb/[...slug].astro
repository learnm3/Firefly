---
import { render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { kbBranchMetaList, kbTypeMetaList } from "@/config/kbConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getSortedKbEntries } from "@/utils/kb-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const entries = await getSortedKbEntries();
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const typeMeta = kbTypeMetaList.find((t) => t.id === entry.data.type);
const branchMeta = kbBranchMetaList.find((b) => b.id === entry.data.branch);

// 描述型徽标颜色
function badgeStyle(hex: string): string {
	return `background:${hex}1f;color:${hex};border:1px solid ${hex}55`;
}
---

<MainGridLayout title={entry.data.title} description={entry.data.description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <!-- 顶部返回 + 徽标 -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <a
          href={url("/kb/")}
          class="inline-flex items-center gap-1.5 text-sm text-50 hover:text-(--primary) transition-colors"
        >
          <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
          返回知识库导图
        </a>
        <span class="text-25">·</span>
        {typeMeta && (
          <span class="text-xs px-2.5 py-1 rounded-full font-medium" style={badgeStyle(typeMeta.color)}>
            {typeMeta.name}
          </span>
        )}
        {branchMeta && (
          <span class="text-xs px-2.5 py-1 rounded-full font-medium" style={badgeStyle(branchMeta.color)}>
            {branchMeta.name}
          </span>
        )}
        <span class="text-xs px-2.5 py-1 rounded-full bg-(--btn-plain-bg) text-50">
          {entry.data.topic || "综合"}
        </span>
      </div>

      <!-- 标题 -->
      <h1
        data-pagefind-meta="title"
        class="transition text-3xl md:text-[2.1rem]/[2.75rem] font-bold text-90 mb-2"
      >
        {entry.data.title}
      </h1>

      <!-- 时间 -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-50 mb-4">
        <span>
          <Icon is:inline name="material-symbols:calendar-today-rounded" class="inline mr-1 align-[-2px]" />
          {formatDateToYYYYMMDD(entry.data.published)}
        </span>
        {entry.data.updated && (
          <span>
            <Icon is:inline name="material-symbols:update-rounded" class="inline mr-1 align-[-2px]" />
            更新于 {formatDateToYYYYMMDD(entry.data.updated)}
          </span>
        )}
        {entry.data.tags.length > 0 && (
          <span class="flex flex-wrap gap-1.5">
            {entry.data.tags.map((tag) => (
              <span class="text-[0.7rem] px-2 py-0.5 rounded bg-(--btn-plain-bg) text-50">#{tag}</span>
            ))}
          </span>
        )}
      </div>

      <div class="border-(--line-divider) border-dashed border-b mb-5" />

      <!-- 正文 -->
      <Markdown class="mb-4 markdown-content">
        <Content />
      </Markdown>

      <!-- 关联博客文章 -->
      {entry.data.relatedPosts.length > 0 && (
        <div class="mt-6 rounded-xl border border-(--line-divider) p-5">
          <div class="flex items-center gap-2 mb-3">
            <Icon is:inline name="material-symbols:article-rounded" class="text-xl text-(--primary)" />
            <h3 class="text-base font-bold text-90">关联博客文章</h3>
          </div>
          <ul class="space-y-2">
            {entry.data.relatedPosts.map((postId) => (
              <li>
                <a
                  href={getPostUrlBySlug(postId)}
                  class="inline-flex items-center gap-1.5 text-sm text-(--primary) hover:underline"
                >
                  <Icon is:inline name="material-symbols:chevron-right-rounded" class="text-base" />
                  {postId}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</MainGridLayout>
