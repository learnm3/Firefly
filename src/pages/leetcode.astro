---
import { Icon } from "astro-icon/components";
import LeetCodeHeatmap from "@/components/pages/career/LeetCodeHeatmap.svelte";
import { leetCodeConfig } from "@/config/leetcodeConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title={leetCodeConfig.title} description={leetCodeConfig.description}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="relative w-full mb-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
                        <Icon is:inline name="material-symbols:code" class="text-[1.5rem]"></Icon>
                    </div>
                    <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
                        {leetCodeConfig.title}
                    </div>
                </div>
                <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    {leetCodeConfig.description}
                </p>
                <a
                    href="/hot100/"
                    class="inline-flex items-center gap-1.5 mt-3 text-sm text-(--primary) hover:underline"
                >
                    <Icon is:inline name="material-symbols:workspace-premium" class="text-[1.1em]"></Icon>
                    查看热题 100 完整题单与进度
                </a>
            </div>

            <LeetCodeHeatmap client:load config={leetCodeConfig} />
        </div>
    </div>
</MainGridLayout>
