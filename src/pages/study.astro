---
import { Icon } from "astro-icon/components";
import StudyTracker from "@/components/pages/study/StudyTracker.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="学习追踪" description="基于艾宾浩斯遗忘曲线的学习记录与复习提醒">
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-4 sm:px-9 py-5 sm:py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="relative w-full mb-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon is:inline name="material-symbols:school" class="text-[1.5rem]"></Icon>
                    </div>
                    <div class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
                        学习追踪
                    </div>
                </div>
                <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    基于<b>艾宾浩斯遗忘曲线</b>的学习记录系统。记录每天学的内容，系统会在 <b>1、2、4、7、15、30 天</b>后自动提醒复习，
                    帮助你把短期记忆转化为长期记忆。进度自动保存在浏览器中。
                </p>
            </div>

            <StudyTracker client:load />
        </div>
    </div>
</MainGridLayout>
